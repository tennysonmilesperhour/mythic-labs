# Copy to .env.local for local dev, or paste these into Vercel project settings.

# --- GitHub (server-side; never reaches the browser) ---
# Fine-grained PAT. Contents read & write on the brain repo (Authoring commits there);
# Contents read on any repo you want the Check button to inspect. Nothing else needs write.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# The repo that hosts your central brain (marketplace.json lives here).
BRAIN_OWNER=tennysonmilesperhour
BRAIN_REPO=mythic-labs

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# Service role key — server-only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxx

# --- Agent API ---
# Bearer token autonomous agents use for /api/agent/*. Unset = agent API off.
PM_AGENT_TOKEN=

# --- Admin gate ---
# Single hardcoded admin id used until we wire real auth.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
