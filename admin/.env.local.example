# Copy to .env.local for local dev, or paste these into Vercel project settings.

# --- GitHub (server-side; never reaches the browser) ---
# Existing authorized token. Contents read & write on the brain repo (Authoring)
# and private project-data repo; read access on repos the dashboard inspects.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# The repo that hosts your central brain (marketplace.json lives here).
BRAIN_OWNER=tennysonmilesperhour
BRAIN_REPO=mythic-labs

# --- Private project data store ---
# Independent destination; repository and branch must already exist and be verified private.
PM_DATA_OWNER=your-account
PM_DATA_REPO=private-project-data
PM_DATA_BRANCH=main
# Local dev without GitHub writes: keep data on disk instead.
# PM_DATA_DIR=./.data

# --- Agent API ---
# Shared trusted-admin bearer token. Agent labels are caller-supplied, not identity.
# Keep disabled until access scope and identity limitations are explicitly approved.
PM_AGENT_API_ENABLED=false
PM_AGENT_TOKEN=
